{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rajvel-website",
  "main": "./worker.js",
  "compatibility_date": "2026-11-23",
  "keep_vars": true,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
